Notebook[{

Cell[CellGroupData[{
Cell["Categorization", "CategorizationSection",ExpressionUUID->"6bca5e7e-ba07-466f-94b4-7a5b852fd753"],

Cell["Symbol", "Categorization",
 CellLabel->
