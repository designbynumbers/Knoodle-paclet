}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"948c7031-406f-4bf1-962f-cf8a2982e236"],

Cell["\<\
Extract the crossing number of an identified knot positionally:\
\>", "ExampleText",ExpressionUUID->"5bdd149f-4958-4c45-90e0-b495df9f3356"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ks", " ", "=", " ", 
    RowBox[{"First", "[", 
     RowBox[{"Keys", "[", 
      RowBox[{"KnoodleIdentify", "[", 
       RowBox[{"Knot", "[", 
        RowBox[{"7", ",", " ", "4"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"296c3a6c-d7b3-4184-9d36-4efbcd2e94dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ks", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",ExpressionUUID->"1ad31ab5-dd74-4026-b1e0-946e8e6e75f4"],

Cell[BoxData["7"], "Output",ExpressionUUID->"edcabe4f-ad49-4e73-b494-506c5ceb8f8c"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
