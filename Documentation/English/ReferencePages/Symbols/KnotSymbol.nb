   RowBox[{"3", ",", " ", "1", ",", " ", "True", ",", " ", "\"\<m/mr\>\""}], 
   "]"}], "]"}]], "Input",ExpressionUUID->"b5f380b9-218d-4bac-9d99-\
d39fe898d5dd"],

Cell[BoxData[
 TagBox[
  StyleBox[
   RowBox[{"KnotSymbol", "[", 
    RowBox[{"3", ",", "1", ",", "True", ",", "\"\<m/mr\>\""}], "]"}],
   ShowSpecialCharacters->False,
   ShowStringCharacters->True,
   NumberMarks->True],
  FullForm]], "Output",ExpressionUUID->"943834c5-71a0-48cd-a67d-debc6645015d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"14492c9c-ec23-4776-a949-5b2b9ab497fb"],

Cell["\<\
Extract the crossing number of an identified knot positionally:\
\>", "ExampleText",ExpressionUUID->"0696f8f8-cd73-4ad4-9715-b25b19f52105"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ks", " ", "=", " ", 
    RowBox[{"First", "[", 
     RowBox[{"Keys", "[", 
      RowBox[{"KnoodleIdentify", "[", 
       RowBox[{"Knot", "[", 
        RowBox[{"7", ",", " ", "4"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"e1898cd4-9ae5-4bfd-99fe-e0f82121f1e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ks", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",ExpressionUUID->"13a4920a-07a7-4b44-9465-3e30ffe6df4d"],

Cell[BoxData["7"], "Output",ExpressionUUID->"4b427e66-46fe-46b6-8195-a73099c473ff"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
