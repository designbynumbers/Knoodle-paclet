Notebook[{

Cell[CellGroupData[{
Cell["Categorization", "CategorizationSection",ExpressionUUID->"479bf217-a6df-4113-be2b-a6fca07c0083"],

Cell["Symbol", "Categorization",
 CellLabel->
  "Entity Type",ExpressionUUID->"427e3943-209e-4861-b600-bf431b8e1fae"],

Cell["Knoodle", "Categorization",
 CellLabel->
  "Paclet Name",ExpressionUUID->"39f1de46-2560-4d49-833c-3c267670c220"],

Cell["Knoodle`", "Categorization",
 CellLabel->"Context",ExpressionUUID->"0563bc2b-2416-4677-826a-e732b84580ea"],

Cell["Knoodle/ref/KnotSymbol", "Categorization",
 CellLabel->"URI",ExpressionUUID->"a9b0a690-2489-4aa4-b769-eb0fd68d6b9d"]
}, Closed]],

Cell[CellGroupData[{

Cell["KnotSymbol", "ObjectName",ExpressionUUID->"332dd223-20e3-4e40-a91c-7095c831aa5f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0dd9c3e5-368c-4e53-bb96-16d3c411c112"],
 Cell[BoxData[
  RowBox[{"KnotSymbol", "[", 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["i", "TI"], ",", 
    StyleBox["alternating", "TI"], ",", 
    StyleBox["coset", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5826c4a2-4096-4228-aed9-443b7a16be6f"],
 "\[LineSeparator]represents a prime knot identified by KnoodleIdentify, in \
KnotInfo naming."
}], "Usage",ExpressionUUID->"8384f4a2-ce22-4369-b35b-bd8d1cf55ae5"],

Cell["\<\
KnotSymbol expressions appear as the keys of the Association that \
KnoodleIdentify returns. c is the knot's minimal crossing number and i its \
index within KnotInfo's per-crossing-number naming scheme (the 2 in 5_2); \
alternating is True or False per KnotInfo's classification; coset names which \
coset of the symmetry group {e, m, r, mr} the identified diagram represents \
(e = identity, m = mirror, r = reverse, mr = both), with '/'-joined values \
when several variants are topologically the same knot, e.g. \"e/r\" or \"m/mr\
\".\
\>", "Notes",ExpressionUUID->"53a9dc52-3cb2-4b02-aa2e-9906d77f84d5"],

Cell["\<\
Each knot has one KnotInfo symmetry type, which determines its possible coset \
values: chiral (\"e\", \"r\", \"m\", \"mr\"), reversible (\"e/r\", \"m/mr\"), \
negative amphichiral (\"e/mr\", \"m/r\"), positive amphichiral (\"e/m\", \
\"r/mr\"), or fully amphichiral (\"e/m/r/mr\").\
\>", "Notes",ExpressionUUID->"cc3d2998-3ac6-40c7-9704-71db1e98486f"],

Cell["\<\
KnotSymbol displays in ordinary KnotInfo notation: c with subscript i for \
knots up to 10 crossings, and c immediately followed by \"a\" (alternating) \
or \"n\" (non-alternating) with subscript i from 11 crossings up. The coset \
appears as a superscript, except that a coset containing e is the unmodified \
variant and displays without one.\
\>", "Notes",ExpressionUUID->"1b2f58cf-bec1-4989-9032-58349e099a37"],

Cell["\<\
The display is formatting only: the FullForm, pattern matching, and equality \
testing of a KnotSymbol expression are unaffected, and its parts can be \
extracted positionally.\
\>", "Notes",ExpressionUUID->"1adf4e2e-7fb6-4545-a5bd-540deff605d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox["Examples", "PrimaryExamplesSection"], ""}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"e5a49166-6776-\
4eca-a2ee-fe069b8d3378"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Knoodle`\>\"", "]"}]], "Input",ExpressionUUID->"df83b03e-6698-4495-86d8-6cefd584c96c"],

Cell["\<\
KnoodleIdentify returns KnotSymbol keys; Knot[3,1] identifies as the \
mirror-trefoil coset:\
\>", "ExampleText",ExpressionUUID->"e6f1ee77-1473-423e-bbaf-c2fbe253edb0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", 
  RowBox[{"Knot", "[", 
   RowBox[{"3", ",", " ", "1"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"7f845995-3cc0-4359-a37a-ae822466d179"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   InterpretationBox[
    TemplateBox[{
      SubscriptBox["3", "1"], "\"m/mr\""},
     "Superscript"],
    Knoodle`KnotSymbol[3, 1, True, "m/mr"]], "\[Rule]", "1"}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"85e07094-3200-4a39-834d-\
72147bb432c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"057470e9-6797-488d-b698-fc26c066bee8"],

Cell["\<\
KnotInfo display notation: the coset superscript is suppressed when the coset \
contains e, and knots of 11 or more crossings carry an \
alternating/non-alternating tag:\
\>", "ExampleText",ExpressionUUID->"4c87dd11-3a9a-47e6-99e3-46c66a0810c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KnotSymbol", "[", 
    RowBox[{"3", ",", " ", "1", ",", " ", "True", ",", " ", "\"\<e/r\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"KnotSymbol", "[", 
    RowBox[{"3", ",", " ", "1", ",", " ", "True", ",", " ", "\"\<m/mr\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"KnotSymbol", "[", 
    RowBox[{
    "11", ",", " ", "456", ",", " ", "True", ",", " ", "\"\<e/r\>\""}], "]"}],
    ",", " ", 
   RowBox[{"KnotSymbol", "[", 
    RowBox[{
    "12", ",", " ", "3541", ",", " ", "False", ",", " ", "\"\<m\>\""}], 
    "]"}]}], "}"}]], "Input",ExpressionUUID->"6c4240ab-ca2e-4205-b6db-\
4e6f3e30c973"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   InterpretationBox[
    SubscriptBox["3", "1"],
    Knoodle`KnotSymbol[3, 1, True, "e/r"]], ",", 
   InterpretationBox[
    TemplateBox[{
      SubscriptBox["3", "1"], "\"m/mr\""},
     "Superscript"],
    Knoodle`KnotSymbol[3, 1, True, "m/mr"]], ",", 
   InterpretationBox[
    SubscriptBox["\<\"11a\"\>", "456"],
    Knoodle`KnotSymbol[11, 456, True, "e/r"]], ",", 
   InterpretationBox[
    TemplateBox[{
      SubscriptBox["\"12n\"", "3541"], "\"m\""},
     "Superscript"],
    Knoodle`KnotSymbol[12, 3541, False, "m"]]}], "}"}]], "Output",ExpressionUU\
ID->"a93a1892-fa98-4f24-b444-7244e9fe6c04"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"bf491a47-3230-4537-8fb9-12104b3a3970"],

Cell["\<\
The display is formatting only; the underlying expression is unchanged:\
\>", "ExampleText",ExpressionUUID->"6152551a-4468-4950-86ab-be52b7981ec1"],

