Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"7437923d-22e6-4798-a3f8-7394c6b41c3d"],

Cell["\<\
The embedded curves have precisely the link type of the input diagram, so \
they can be fed straight back into the pipeline -- here KnoodleIdentify \
recovers 8_2 from the points of its own embedding. The embedding is \
randomized, though, so the curve (and even its number of vertices) differs \
from run to run:\
\>", "ExampleText",ExpressionUUID->"9a87e5de-3a63-4be2-812a-ad3526a77e26"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"curve", " ", "=", " ", 
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"KnoodleDraw", "[", 
        RowBox[{
         RowBox[{"Knot", "[", 
          RowBox[{"8", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{"\"\<DrawingDimension\>\"", " ", "->", " ", "3"}]}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"Tube", "[", 
         RowBox[{"p_", ",", " ", "_"}], "]"}], " ", ":>", " ", 
        RowBox[{"Most", "[", "p", "]"}]}], ",", " ", "Infinity"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->\
"7f96f9d3-40b1-4cfe-ada9-384d52d184b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", "curve", "]"}]], "Input",ExpressionUUID->"9a071f0e-34b3-4d48-b1c0-07c54f03b72f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   InterpretationBox[
    TemplateBox[{
      SubscriptBox["8", "2"], "\"m/mr\""},
     "Superscript"],
    Knoodle`KnotSymbol[8, 2, True, "m/mr"]], "\[Rule]", "1"}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"523c1a10-4ab3-401d-8e75-\
6f5d3e554ace"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"864d32a1-d5d5-4fec-9ba3-48cad4a7f0d6"],

Cell["\<\
Because the embedded curve has exactly the input's knot type, \
\"DrawingDimension\" -> 3 doubles as a way to repair bad geometry. A random \
50-gon in the unit ball is about as bad as a closed polygon gets: its longest \
edge is 19 times its shortest, and non-adjacent edges pass within a seventh \
of that shortest edge of each other. Nothing about its knot type is visible:\
\>", "ExampleText",ExpressionUUID->"ad2f1906-5bcb-461f-8cbf-bda553d9e1e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "933", "]"}], ";", " ", 
   RowBox[{"K", " ", "=", " ", 
    RowBox[{"RandomPoint", "[", 
     RowBox[{
      RowBox[{"Ball", "[", "]"}], ",", " ", "50"}], "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"d783ca0f-033c-456a-beda-60d1c615d446"],

