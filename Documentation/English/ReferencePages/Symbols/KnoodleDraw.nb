Cell["\<\
The two really are the same knot: the original polygon and its own embedding \
both identify as the trefoil, in the same chirality class. Only the geometry \
improved -- and since the embedding is randomized, a second call gives a \
different curve, with a different vertex count, that still identifies the \
same way:\
\>", "ExampleText",ExpressionUUID->"58dd2d79-2b04-422b-92b5-f8b66b6c3cb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"emb", " ", "=", " ", 
    RowBox[{
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"KnoodleDraw", "[", 
        RowBox[{"K", ",", " ", 
         RowBox[{"\"\<DrawingDimension\>\"", " ", "->", " ", "3"}]}], "]"}], ",",
        " ", 
       RowBox[{
        RowBox[{"Tube", "[", 
         RowBox[{"p_", ",", " ", "_"}], "]"}], " ", ":>", " ", 
        RowBox[{"Most", "[", "p", "]"}]}], ",", " ", "Infinity"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->\
"7a5bd0d5-1bec-47ce-b036-bd235605f36e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"KnoodleIdentify", "[", "K", "]"}], ",", " ", 
   RowBox[{"KnoodleIdentify", "[", "emb", "]"}]}], "}"}]], "Input",ExpressionU\
UID->"b4e3f748-e415-49e6-aed7-a7204e8d5a5a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     InterpretationBox[
      SubscriptBox["3", "1"],
      Knoodle`KnotSymbol[3, 1, True, "e/r"]], "\[Rule]", "1"}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     InterpretationBox[
      SubscriptBox["3", "1"],
      Knoodle`KnotSymbol[3, 1, True, "e/r"]], "\[Rule]", "1"}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",ExpressionUUID->"b3b844b9-\
d6b8-4e03-8c46-c95b80a014a7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"2f666c69-6112-407b-8b64-41faa1a804e7"],

Cell["\<\
\"ExteriorFace\" chooses which face is laid out as the unbounded exterior \
region; label the faces to see the ids:\
\>", "ExampleText",ExpressionUUID->"fcc666f6-e03a-457f-a98b-33fc91c8506b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KnoodleDraw", "[", 
      RowBox[{"pd", ",", " ", 
       RowBox[{"\"\<Labels\>\"", " ", "->", " ", "\"\<Faces\>\""}], ",", " ", 
       
       RowBox[{"ImageSize", " ", "->", " ", "160"}]}], "]"}], ",", " ", 
     RowBox[{"KnoodleDraw", "[", 
      RowBox[{"pd", ",", " ", 
       RowBox[{"\"\<Labels\>\"", " ", "->", " ", "\"\<Faces\>\""}], ",", " ", 
       
       RowBox[{"\"\<ExteriorFace\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "160"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Spacer", "[", "20", "]"}]}], "]"}]], "Input",ExpressionUUID->\
"860f7e6c-8578-4d93-8f2d-320d6e6edcf5"],

