Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"0e3becb2-8672-4f3c-ba22-0377781e67b9"],

Cell["\<\
3D geometry is simplified before drawing by default. Turn \"Simplify\" off to \
draw the raw projection of a Gaussian random 200-gon, with well over a \
hundred crossings:\
\>", "ExampleText",ExpressionUUID->"0cb80a89-d2f6-4888-bfd9-c90ed3d4a9fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianRandomPolygon", "[", "n_", "]"}], " ", ":=", " ", 
  RowBox[{"Accumulate", "[", 
   RowBox[{"Standardize", "[", 
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "Mean", ",", 
     " ", 
     RowBox[{"1", " ", "&"}]}], " ", "]"}], "]"}]}]], "Input",ExpressionUUID->\
"e6ea0e5e-a9ca-4642-8bd7-b6abd6875f02"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "3", "]"}], ";", " ", 
   RowBox[{"P", " ", "=", " ", 
    RowBox[{"GaussianRandomPolygon", "[", "200", "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"dd03ab69-5f35-4b8c-8236-88b8ba23c6d6"],

