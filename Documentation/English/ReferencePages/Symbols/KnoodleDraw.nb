Cell["", "ExampleDelimiter",ExpressionUUID->"586600dd-87f1-483f-9425-e32552cb3da5"],

Cell["\<\
\"DrawingDimension\" -> 3 goes the other way: instead of a diagram it returns \
a Graphics3D of a 3D embedding of the same link, one tube per link component. \
Here the knot 8_2 and the Hopf link of the previous example, whose two \
components keep the colors the diagram gave them:\
\>", "ExampleText",ExpressionUUID->"8841aa2c-f63c-428f-b4df-55b8854fac45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"KnoodleDraw", "[", 
      RowBox[{
       RowBox[{"Knot", "[", 
        RowBox[{"8", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"\"\<DrawingDimension\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "230"}]}], "]"}], ",", " ", 
     RowBox[{"KnoodleDraw", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c1", ",", " ", "c2"}], "}"}], ",", " ", 
       RowBox[{"\"\<DrawingDimension\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "230"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"Spacer", "[", "20", "]"}]}], "]"}]], "Input",ExpressionUUID->\
"12ffc32f-67fd-4ce5-bf82-ceef470ccd95"],

