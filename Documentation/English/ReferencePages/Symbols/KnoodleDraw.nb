Cell["", "ExampleDelimiter",ExpressionUUID->"3001eb90-1974-4eff-bc45-537f2100d7dd"],

Cell["\<\
A list of point lists is a multi-component link, one closed 3D curve per \
component. Two circles in orthogonal planes form a Hopf link:\
\>", "ExampleText",ExpressionUUID->"a516695d-e94d-47f0-80d1-2b290da75df0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"c1", " ", "=", " ", 
    RowBox[{"Most", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
          RowBox[{"Sin", "[", "t", "]"}], ",", " ", "0"}], "}"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.", ",", " ", 
         RowBox[{"2", "*", "Pi"}], ",", " ", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "60"}], ")"}]}]}], "}"}]}], "]"}], "]"}]}], 
   ";"}], " "}]], "Input",ExpressionUUID->"1f6fb585-f4e1-4ad8-8d70-\
702af702dd0c"],

