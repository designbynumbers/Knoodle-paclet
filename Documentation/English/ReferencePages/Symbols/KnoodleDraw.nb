Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"81db9bf5-0b6a-416b-886f-60cebe37c355"],

Cell["\<\
A 13-crossing knot, drawn by DrawPD (left) and KnoodleDraw (right) from \
KnotInfo's published PD code for 13a_1 (the same pd13a1 as above); \
KnoodleIdentify confirms the knot:\
\>", "ExampleText",ExpressionUUID->"06a34cdf-100f-42d3-9c6f-95a8352ef6b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", "pd13a1", "]"}]], "Input",ExpressionUUID->"2c78ba6c-265a-448c-9a78-99112aa969c2"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   InterpretationBox[
    SubscriptBox["\<\"13a\"\>", "1"],
    Knoodle`KnotSymbol[13, 1, True, "e/r"]], "\[Rule]", "1"}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"25ab10bc-3eaa-475b-87d8-\
981e914d205a"]
}, Open  ]],

