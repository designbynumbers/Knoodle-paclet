Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleDraw", "[", 
  RowBox[{"pd", ",", " ", 
   RowBox[{"\"\<Labels\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Crossings\>\"", ",", " ", "\"\<Arcs\>\""}], "}"}]}], ",", 
