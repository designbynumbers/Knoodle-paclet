   ",", " ", 
   RowBox[{"Boxed", " ", "->", " ", "False"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]], "Input",ExpressionU\
UID->"1052f373-d055-4143-b7bd-99bd61d537c0"],

