Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"67914f6a-43fa-4a02-9f12-fa296e436f61"],

Cell["\<\
Strand thickness scales with the diagram by default, keeping the over/under \
gaps at every crossing visible even on dense diagrams. Here a (2,15) torus \
knot is drawn from a sampled space curve:\
\>", "ExampleText",ExpressionUUID->"0a5772db-14d7-452d-a746-44c329afa565"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"torus", " ", "=", " ", 
    RowBox[{"Most", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"15", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"15", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"15", "*", "t"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.", ",", " ", 
         RowBox[{"2", "*", "Pi"}], ",", " ", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "600"}], ")"}]}]}], "}"}]}], "]"}], "]"}]}], 
   ";"}], " "}]], "Input",ExpressionUUID->"c326041b-8dd8-4d0c-9b53-\
6a6e2f9b5fb3"],

