Cell["\<\
Drawing the same points in dimension 3 replaces them with a curve of \
precisely the same knot type, laid out on Reapr's grid: about 20 vertices \
instead of 50, every edge a whole number of grid pitches, and non-adjacent \
strands a full pitch apart. It is a trefoil, and now it looks like one:\
\>", "ExampleText",ExpressionUUID->"38ab823e-f8a6-4027-94d3-a0847d7d190a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleDraw", "[", 
  RowBox[{"K", ",", " ", 
   RowBox[{"\"\<DrawingDimension\>\"", " ", "->", " ", "3"}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "260"}]}], "]"}]], "Input",ExpressionU\
UID->"0d51da4a-9248-4caa-ad7e-503f575304f3"],

Cell[BoxData[
 Graphics3DBox[
  {RGBColor[0.368417, 0.506779, 0.709798], TubeBox[CompressedData["
