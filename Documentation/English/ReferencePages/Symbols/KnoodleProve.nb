Cell[BoxData[
 RowBox[{"Last", "[", 
  RowBox[{"r", "[", "\"\<Claims\>\"", "]"}], "]"}]], "Input",ExpressionUUID->\
"2fdb20e1-c7d4-426a-854b-6d3bbaea8f45"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Step\"\>", "\[Rule]", "All"}], ",", 
   RowBox[{"\<\"Claim\"\>", "\[Rule]", "\<\"unlink\"\>"}], ",", 
   RowBox[{"\<\"Verdict\"\>", "\[Rule]", "\<\"VERIFIED\"\>"}], ",", 
   RowBox[{"\<\"Detail\"\>", 
    "\[Rule]", "\<\"the input's 1 component, colour 0, each came free exactly \
