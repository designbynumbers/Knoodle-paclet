Cell["\<\
The Freedman\[Dash]He\[Dash]Wang hard unknot, with 32 crossings, taken to the \
empty diagram by 11 pass moves and 4 curl removals. The trace proves it an \
unknot:\
\>", "ExampleText",ExpressionUUID->"66cf926d-d2c5-4387-b97a-4ba072350392"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fhw", " ", "=", " ", 
   RowBox[{"KnoodleProve", "[", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", "\"\<fhw_unlink.trace\>\""}], "}"}], "]"}], 
     "]"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"fhw", "[", "\"\<Verdict\>\"", "]"}], ",", " ", 
    RowBox[{"fhw", "[", "\"\<Unlink\>\"", "]"}]}], "}"}]}]], "Input",Expressio\
nUUID->"c7f6c60c-104c-4140-8745-e27de64535b1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VERIFIED\"\>", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"5f13b11e-3d70-47b4-8758-fbda4a93f45b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Last", "[", 
  RowBox[{"fhw", "[", "\"\<Claims\>\"", "]"}], "]"}]], "Input",ExpressionUUID->\
"eeb0ee64-31a0-4349-ba15-5a84fe57f702"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Step\"\>", "\[Rule]", "All"}], ",", 
   RowBox[{"\<\"Claim\"\>", "\[Rule]", "\<\"unlink\"\>"}], ",", 
   RowBox[{"\<\"Verdict\"\>", "\[Rule]", "\<\"VERIFIED\"\>"}], ",", 
   RowBox[{"\<\"Detail\"\>", 
    "\[Rule]", "\<\"the input's 1 component, colour 0, each came free exactly \
once; 15 moves, every one sound and every link VERIFIED\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"a6bf020f-88d9-448b-b03a-\
927eee67b687"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Counts", "[", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{"fhw", "[", "\"\<Claims\>\"", "]"}], ",", " ", "\"\<Claim\>\""}], 
   "]"}], "]"}]], "Input",ExpressionUUID->"4f7234f7-9ad2-4e1f-b66b-\
3e3a3fbb0354"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"result\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"colors\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"trace\"\>", "\[Rule]", "15"}], ",", 
   RowBox[{"\<\"r1\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"split\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"spinoffs\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"unlink\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"c5e193d2-2b55-42e8-a0fe-\
d9e13e581c2c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"050f8f5a-6795-4f53-bb9b-5cab377ccb24"],

Cell["\<\
A middle pass goes over some of what it crosses and under the rest. It is \
sound only by the feasibility witness the trace gives with it, so its witness \
is checked as well (V0, V4, and V2, V3 and V5):\
\>", "ExampleText",ExpressionUUID->"f700752d-c3d1-4ce6-ad4e-0f0591dfdb1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"mp", " ", "=", " ", 
   RowBox[{"KnoodleProve", "[", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", "\"\<middlepass_unlink.trace\>\""}], "}"}], 
      "]"}], "]"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"mp", "[", "\"\<Verdict\>\"", "]"}], ",", " ", 
    RowBox[{"mp", "[", "\"\<Unlink\>\"", "]"}]}], "}"}]}]], "Input",Expression\
UUID->"ca4eae53-a0fc-44cb-ba49-948047452db3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VERIFIED\"\>", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"19ebefe0-2c4a-4f82-9f09-e252436ec581"]
}, Open  ]],

Cell["\<\
Record 4 is a candidate: a middle pass the simplifier evaluated, witness and \
all, without making it. Record 5 makes it. The claims about record 5:\
\>", "ExampleText",ExpressionUUID->"4b984346-f313-4aba-bbec-89bfb5f3d2c8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"mp", "[", "\"\<Claims\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#Step", " ", "===", " ", "5"}], " ", "&"}]}], " ", "]"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Claim\>\"", ",", " ", "\"\<Verdict\>\"", ",", 
       " ", "\"\<Detail\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "28"}], "}"}], 
     "}"}]}]}], "]"}]], "Input",ExpressionUUID->"4603e988-cbc1-4e1c-b865-\
a869e9f1fcfe"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"result\"\>", "\<\"VERIFIED\"\>", "\<\"port-by-port against the \
applier\"\>"},
    {"\<\"colors\"\>", "\<\"VERIFIED\"\>", "\<\"1 component colour carried \
through the move\"\>"},
    {"\<\"disk (V0)\"\>", "\<\"VERIFIED\"\>", "\<\"side 0: 7 interior \
crossings, 17 pieces\"\>"},
    {"\<\"classes (V4)\"\>", "\<\"VERIFIED\"\>", "\<\"5 classes, exactly the \
same-strand unions\"\>"},
    {"\<\"labels (V2/V3/V5)\"\>", "\<\"VERIFIED\"\>", "\<\"7 germs, 7 \
orderings, 1 tags\"\>"},
    {"\<\"trace\"\>", "\<\"VERIFIED\"\>", "\<\"8 crossings expected, 8 found, \
colours kept\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {Automatic, Automatic, 28}}],
  "Grid"]], "Output",ExpressionUUID->"f39a5288-918c-4aff-9cf1-7d6414c0da83"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"88da8095-dba9-4521-ae2a-b2b061a64f8a"],

Cell["\<\
A redraw views the same curve on the integer lattice from another side. Here \
the Hopf link, its two components' colours kept. Every claim checks out; the \
trace does not end at the empty diagram, so it proves no unlink:\
\>", "ExampleText",ExpressionUUID->"4701a1f0-60f0-42b6-9fbd-374b71a4b1ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rd", " ", "=", " ", 
   RowBox[{"KnoodleProve", "[", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", "\"\<redraw_link_example.trace\>\""}], "}"}], 
      "]"}], "]"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rd", "[", "\"\<Verdict\>\"", "]"}], ",", " ", 
    RowBox[{"rd", "[", "\"\<Unlink\>\"", "]"}]}], "}"}]}]], "Input",Expression\
UUID->"b6d1a7ff-bae3-4038-a9c3-fa05450c40a8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VERIFIED\"\>", ",", "False"}], "}"}]], "Output",ExpressionUUID->\
"4e2bc9dc-c293-4e99-af53-45dad08d8237"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"rd", "[", "\"\<Claims\>\"", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Claim\>\"", ",", " ", "\"\<Detail\>\""}], "}"}]}], "]"}], ",",
    " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "32"}], "}"}], "}"}]}]}], "]"}]], "Input",\
ExpressionUUID->"0a717859-f03b-48a4-a524-241d4a55247b"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"redraw\"\>", "\<\"rotation x->y->z->x (+2pi/3 about (1,1,1))\"\>"},
    {"\<\"projection\"\>", "\<\"E has 2 component(s), 8 lattice vertices; \
project(E) is the snapshot, 2 crossings, colours kept\"\>"},
    {"\<\"rotated\"\>", "\<\"project(R*E) has 4 crossings, connected; checked \
against the next snapshot\"\>"},
    {"\<\"trace\"\>", "\<\"4 crossings expected, 4 found, colours kept\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {Automatic, 32}}],
  "Grid"]], "Output",ExpressionUUID->"ccd4bfd9-4da7-4199-b8df-8dea607afa39"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"892d6bfd-e566-4f75-8875-a7e9ce93de25"],

Cell["\<\
Six records of a longer run whose '#view' lines, which say which face of each \
diagram is the outside one, are wrong. The moves check out. The one UNCHECKED \
claim is the last move's result, since no record follows it to compare with:\
\>", "ExampleText",ExpressionUUID->"7e90d205-b583-4e0b-b8b9-ff8c9a1afa1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sticky", " ", "=", " ", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", "\"\<exterior_sticky_example.trace\>\""}], 
       "}"}], "]"}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->\
"eb95600e-7c36-4e0e-92b6-06c303ea56f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Counts", "[", 
  RowBox[{"Lookup", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"KnoodleProve", "[", "sticky", "]"}], "[", "\"\<Claims\>\"", 
     "]"}], ",", " ", "\"\<Verdict\>\""}], "]"}], "]"}]], "Input",ExpressionUU\
ID->"6f6b1cc4-9fa1-4752-b55d-fe787642e767"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"VERIFIED\"\>", "\[Rule]", "23"}], ",", 
   RowBox[{"\<\"UNCHECKED\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"3ec7f700-c436-4654-8b99-\
7beebd337780"]
}, Open  ]],

Cell["\<\
With \"CheckExterior\" -> True the views are checked too, and four of the six \
are refused:\
\>", "ExampleText",ExpressionUUID->"d372be37-e281-49a9-adec-be5afda401eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KnoodleProve", "[", 
         RowBox[{"sticky", ",", " ", 
          RowBox[{"\"\<CheckExterior\>\"", " ", "->", " ", "True"}]}], "]"}], 
        "[", "\"\<Claims\>\"", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#Claim", " ", "===", " ", "\"\<exterior\>\""}], " ", "&"}]}],
       " ", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Step\>\"", ",", " ", "\"\<Verdict\>\"", ",", 
       " ", "\"\<Detail\>\""}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "32"}], "}"}], 
     "}"}]}]}], "]"}]], "Input",ExpressionUUID->"d5d41af7-6e82-4a24-80ed-\
bb6ae127cc0a"],

Cell[BoxData[
 TagBox[GridBox[{
    {"0", "\<\"MISMATCH\"\>", "\<\"the corridor cuts the exterior face, so \
'#view' must say outside=0|1\"\>"},
    {"1", "\<\"MISMATCH\"\>", "\<\"the next record's exterior is face 1 (darc \
7), but face 3 on side 0 goes to face 3\"\>"},
    {"2", "\<\"VERIFIED\"\>", "\<\"face 1 -> face 1, outside=0\"\>"},
    {"3", "\<\"MISMATCH\"\>", "\<\"the next record's exterior is face 3 (darc \
7), but face 1 on side 1 goes to face 4\"\>"},
    {"4", "\<\"VERIFIED\"\>", "\<\"candidate; no following record to continue \
into\"\>"},
    {"5", "\<\"MISMATCH\"\>", "\<\"'behind' is missing: infinity is on side 0 \
and the swept side is 0\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {Automatic, Automatic, 32}}],
  "Grid"]], "Output",ExpressionUUID->"59613a94-3f3b-4255-a641-99a396a25cc4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"abedfbc3-4f66-472e-877c-857d316eb4bc"],

Cell["\<\
A trace knoodleprove cannot read gives $Failed, with a \
KnoodleProve::knoodletool message quoting its error:\
\>", "ExampleText",ExpressionUUID->"050b40c3-f3d2-45d2-8912-d7aa5d3b5daa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleProve", 
  "[", "\"\<#trace v=1\\n#step n=0 summand=0\\nnot a diagram\\n\>\"", 
  "]"}]], "Input",ExpressionUUID->"06acca98-f624-4d9b-b7ac-09d89a7c9c06"],

Cell[BoxData["$Failed"], "Output",ExpressionUUID->"add9966e-9487-4ee8-b6c4-576de0cc3f97"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
