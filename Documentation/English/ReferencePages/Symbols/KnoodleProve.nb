Cell["\<\
Check a bundled trace: a pass move on a 3-crossing diagram of the unknot, \
then the removal of the curl it leaves:\
\>", "ExampleText",ExpressionUUID->"74b32236-a53a-4138-be40-2099a2ffd43a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dir", " ", "=", " ", 
    RowBox[{
     RowBox[{"PacletObject", "[", "\"\<Knoodle\>\"", "]"}], "[", 
     RowBox[{"\"\<AssetLocation\>\"", ",", " ", "\"\<ExampleTraces\>\""}], 
     "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->"a69e000f-c836-437e-aca4-\
293f80d669ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"r", " ", "=", " ", 
   RowBox[{"KnoodleProve", "[", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dir", ",", " ", "\"\<pass_lasso.trace\>\""}], "}"}], "]"}], 
     "]"}], "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"r", "[", "\"\<Verdict\>\"", "]"}], ",", " ", 
    RowBox[{"r", "[", "\"\<Unlink\>\"", "]"}]}], "}"}]}]], "Input",ExpressionU\
UID->"d1b0fd65-aa67-4356-acc1-6cf1f7a6b498"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"VERIFIED\"\>", ",", "True"}], "}"}]], "Output",ExpressionUUID->\
"8d2280ca-ba50-4e6c-801b-7d88435467fd"]
}, Open  ]],

Cell["The claims, in order. The last is about the whole trace:", "ExampleText",ExpressionUUID->"faf82ff8-ac86-4136-b184-aa8183c864b3"],

