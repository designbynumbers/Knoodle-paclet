Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"afddc7cb-24f4-4712-b355-9547e5f7c780"],

Cell["\<\
A trace is text. Each record gives a move and the diagram it acts on, in \
Knoodle's own serialization of a planar diagram:\
\>", "ExampleText",ExpressionUUID->"d4d68932-82cd-4be8-b67f-db0a265381e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lasso", " ", "=", " ", 
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dir", ",", " ", "\"\<pass_lasso.trace\>\""}], "}"}], "]"}], ",",
       " ", "\"\<Text\>\""}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->\
"f331bd3f-14db-41eb-bdb1-7fffc5302703"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"StringSplit", "[", 
    RowBox[{"lasso", ",", " ", "\"\<\\n\>\""}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"4", " ", ";;", " ", "22"}], "]"}], "]"}], "]"}]], "Input",Express\
ionUUID->"1a7c43d3-05b3-430f-960a-40c73e473ee3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"#step n=0 summand=0\"\>"},
    {"\<\"#comment A LASSO (ROUND-24): tail anchor = head anchor = crossing \
0. The descending\"\>"},
    {"\<\"#comment trefoil shadow (O O O U U U) has no other reducing move. \
Record 0 is the\"\>"},
    {"\<\"#comment under-lasso, k = 0, with middlestrands' ReroutePrescribed \
#result; it leaves\"\>"},
    {"\<\"#comment a curl at crossing 0, which record 1's r1 removes.\"\>"},
    {"\<\"#comment tier=pass lasso c_0=c_3 saving=2\"\>"},
    {"\<\"#move kind=pass strand=1,3,5 depart=1 cross= land=5\"\>"},
    {"\<\"#state lines=12\"\>"},
    {"\<\"PlanarDiagram<I64>\"\>"},
    {"\<\"max_crossing_count = 3\"\>"},
    {"\<\"crossing_count = 3\"\>"},
    {"\<\"max_arc_count = 6\"\>"},
    {"\<\"arc_count = 6\"\>"},
    {"\<\"C_arcs = {{{0,3},{2,5}},{{4,1},{0,3}},{{2,5},{4,1}}}\"\>"},
    {"\<\"C_state = {-1,-1,1}\"\>"},
    {"\<\"A_cross = {{0,1},{1,2},{2,0},{0,1},{1,2},{2,0}}\"\>"},
    {"\<\"A_state = {1,1,1,1,1,1}\"\>"},
    {"\<\"A_color = {0,0,0,0,0,0}\"\>"},
    {"\<\"last_color_deactivated = -1\"\>"}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",ExpressionUUID->"9a27f618-f54f-479f-890e-1420ed925b48"]
}, Open  ]],

Cell["The text itself can be checked:", "ExampleText",ExpressionUUID->"74ce0c7e-bd59-481a-bd8c-544d0e06a7e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"KnoodleProve", "[", "lasso", "]"}], "[", "\"\<Verdict\>\"", 
  "]"}]], "Input",ExpressionUUID->"f9c2a57a-bde4-47c3-871c-db9591767314"],

Cell[BoxData["\<\"VERIFIED\"\>"], "Output",ExpressionUUID->"96ba0bac-3f23-4174-965b-b28d19673f9e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"158446c3-5b3c-42b4-888a-4688930738b0"],

Cell["\<\
Change one crossing of the input, so the diagram alternates and is a trefoil. \
The trace no longer proves anything: the strand of its pass move now goes \
over at one crossing and under at another, so the move is not a pass move at \
all:\
\>", "ExampleText",ExpressionUUID->"589db986-bc96-46fc-8c68-ef8bd96abdd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"trefoil", " ", "=", " ", 
    RowBox[{"StringReplace", "[", 
     RowBox[{"lasso", ",", " ", 
      RowBox[{"\"\<C_state = {-1,-1,1}\>\"", " ", "->", 
       " ", "\"\<C_state = {-1,-1,-1}\>\""}], ",", " ", "1"}], "]"}]}], ";"}],
   " "}]], "Input",ExpressionUUID->"9312cfab-9eac-4f8d-ab36-e064cef125c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rt", " ", "=", " ", 
   RowBox[{"KnoodleProve", "[", "trefoil", "]"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"rt", "[", "\"\<Verdict\>\"", "]"}], ",", " ", 
    RowBox[{"rt", "[", "\"\<Unlink\>\"", "]"}]}], "}"}]}]], "Input",Expression\
UUID->"c16d2fc2-7ce1-4720-a0c0-e9a5a1261e90"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"MISMATCH\"\>", ",", "False"}], "}"}]], "Output",ExpressionUUID->\
"56b17de7-4c95-48fc-96d0-e196d29e4b37"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SelectFirst", "[", 
  RowBox[{
   RowBox[{"rt", "[", "\"\<Claims\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"#Verdict", " ", "===", " ", "\"\<MISMATCH\>\""}], " ", "&"}]}], 
  " ", "]"}]], "Input",ExpressionUUID->"e2c7bd07-5c14-4504-9a35-95b0f9150a06"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Step\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Claim\"\>", "\[Rule]", "\<\"descriptor\"\>"}], ",", 
   RowBox[{"\<\"Verdict\"\>", "\[Rule]", "\<\"MISMATCH\"\>"}], ",", 
   RowBox[{"\<\"Detail\"\>", 
    "\[Rule]", "\<\"not well-formed against this snapshot: the strand passes \
over at some of its interior crossings and under at others, so it is not a \
pass move at all (use kind=middlepass)\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"1a419e2b-7182-435d-8dad-\
8d5741dcde4e"]
}, Open  ]],

Cell["\<\
With that link of the chain broken, the trace proves no unlink:\
\>", "ExampleText",ExpressionUUID->"231a547f-998a-46b6-b1b0-4aa8c5164651"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Last", "[", 
  RowBox[{"rt", "[", "\"\<Claims\>\"", "]"}], "]"}]], "Input",ExpressionUUID->\
"1f1a4935-5447-4a7b-8045-94516f5d9331"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Step\"\>", "\[Rule]", "All"}], ",", 
   RowBox[{"\<\"Claim\"\>", "\[Rule]", "\<\"unlink\"\>"}], ",", 
   RowBox[{"\<\"Verdict\"\>", "\[Rule]", "\<\"UNCHECKED\"\>"}], ",", 
   RowBox[{"\<\"Detail\"\>", 
    "\[Rule]", "\<\"the chain is broken: a claim along it came back \
MISMATCH\"\>"}]}], "\[RightAssociation]"}]], "Output",ExpressionUUID->\
"ef131c55-bd25-4f8d-8c12-60aa4f4310f2"]
}, Open  ]]
}, Open  ]],

