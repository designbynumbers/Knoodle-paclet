Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"ab75ca69-cb05-4c54-8bc3-9b8bbba59201"],

Cell["\<\
A knot with more crossings than the lookup table covers comes back as \
Unidentified together with its signed PD code. Here a (2,17) torus knot is \
sampled as a space curve:\
\>", "ExampleText",ExpressionUUID->"894cc9ef-cc78-40f6-b6bc-c0045f39f658"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"torus", " ", "=", " ", 
    RowBox[{"Most", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"17", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"17", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"17", "*", "t"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.", ",", " ", 
         RowBox[{"2", "*", "Pi"}], ",", " ", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "680"}], ")"}]}]}], "}"}]}], "]"}], "]"}]}], 
   ";"}], " "}]], "Input",ExpressionUUID->"09c61a79-e2f3-472d-b0e4-\
2615650ee458"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", "torus", "]"}]], "Input",ExpressionUUID->"3cb3596f-efcd-4b26-ae3e-6c6e954194f4"],

