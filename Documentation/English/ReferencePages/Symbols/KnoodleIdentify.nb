Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"66782b7e-1791-49e2-b411-d89cb42c1a19"],

Cell["\<\
A composite knot reports each distinct prime factor with its multiplicity. \
The granny knot is the connect sum of two like-handed trefoils, given here as \
two PD-code summands:\
\>", "ExampleText",ExpressionUUID->"5a46e5a7-5e7b-4e42-ab76-c859845d7ceb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"granny", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "2", ",", " ", "0", ",", " ", "3", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "4", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "5", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}]}], "}"}], 
      ",", " ", 
      RowBox[{"{", 
