Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"848b9628-46ef-4bf0-8b74-23aa410857ec"],

Cell["\<\
A knot with more crossings than the lookup table covers comes back as \
Unidentified together with its signed PD code. Here a (2,17) torus knot is \
sampled as a space curve:\
\>", "ExampleText",ExpressionUUID->"a76bda1f-cc91-4302-98be-09a673cf0786"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"torus", " ", "=", " ", 
    RowBox[{"Most", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"17", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"2", "*", "t"}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"2", " ", "+", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"17", "*", "t"}], "]"}]}], ")"}]}], ",", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"17", "*", "t"}], "]"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0.", ",", " ", 
         RowBox[{"2", "*", "Pi"}], ",", " ", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "680"}], ")"}]}]}], "}"}]}], "]"}], "]"}]}], 
   ";"}], " "}]], "Input",ExpressionUUID->"3055511b-4e24-4c94-b62e-\
038ab86017e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", "torus", "]"}]], "Input",ExpressionUUID->"e4b42730-1d88-4996-83b0-0b2c4cf0e1f9"],

