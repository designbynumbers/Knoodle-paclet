Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"1c054cc4-76ee-4b86-8931-dc7e83ce0c7f"],

Cell["\<\
A composite knot reports each distinct prime factor with its multiplicity. \
The granny knot is the connect sum of two like-handed trefoils, given here as \
two PD-code summands:\
\>", "ExampleText",ExpressionUUID->"44dd19f2-b262-4c66-9af4-7f285fd648c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"granny", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "2", ",", " ", "0", ",", " ", "3", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "4", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "5", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}]}], "}"}], 
      ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "2", ",", " ", "0", ",", " ", "3", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "0", ",", " ", "4", ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "5", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "3"}], "}"}]}], 
       "}"}]}], "}"}]}], ";"}], " "}]], "Input",ExpressionUUID->"16da9b4e-\
2dbc-468a-be53-ff7e473a5894"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KnoodleIdentify", "[", "granny", "]"}]], "Input",ExpressionUUID->"d0e6f063-24f4-4bca-93eb-d10899b86ade"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   InterpretationBox[
    TemplateBox[{
      SubscriptBox["3", "1"], "\"m/mr\""},
     "Superscript"],
