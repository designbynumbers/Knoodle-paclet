Cell["\<\
Both KnoodleSimplify and KnoodleIdentify handle large geometric input \
quickly. Generate a Gaussian random polygon with 5000 vertices:\
\>", "ExampleText",ExpressionUUID->"dd57fe15-6479-4e7f-a93b-44d9d091a032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianRandomPolygon", "[", "n_", "]"}], " ", ":=", " ", 
  RowBox[{"Accumulate", "[", 
   RowBox[{"Standardize", "[", 
    RowBox[{
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "3"}], "}"}]}], "]"}], ",", " ", "Mean", ",", 
     " ", 
     RowBox[{"1", " ", "&"}]}], " ", "]"}], "]"}]}]], "Input",ExpressionUUID->\
"8498e99f-462a-4020-b879-bdccccfbfb35"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
   RowBox[{"P", " ", "=", " ", 
    RowBox[{"GaussianRandomPolygon", "[", "5000", "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"27375997-c80f-4cbc-83ea-1f4aa2e9bd7c"],

