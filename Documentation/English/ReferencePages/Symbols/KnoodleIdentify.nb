Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"d2156d46-ccad-4095-a01a-2ee2ff7dccab"],

Cell["\<\
9_32 is chiral and noninvertible, so its four symmetry variants (identity, \
reverse, mirror, mirror-reverse) are four genuinely different oriented knots, \
and KnoodleIdentify assigns each its own coset. Mirroring a PD code flips \
every crossing; reversal renumbers the arcs backwards:\
\>", "ExampleText",ExpressionUUID->"cd0bcdc9-fb88-4577-b380-fd80f5621d96"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mirrorPD", "[", "p_PD", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "p", "]"}]}], "}"}], ",", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", " ", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], 
          "]"}], " ", ":>", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"l", " ", "-", " ", "j"}], ",", " ", 
              RowBox[{"2", "*", "n"}]}], "]"}], " ", "==", " ", "1"}], ",", 
           " ", 
           RowBox[{"X", "[", 
            RowBox[{"j", ",", " ", "k", ",", " ", "l", ",", " ", "i"}], "]"}],
            ",", " ", 
           RowBox[{"X", "[", 
            RowBox[{"l", ",", " ", "i", ",", " ", "j", ",", " ", "k"}], 
            "]"}]}], "]"}]}], ",", " ", "1"}], "]"}]}], "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"2291461b-d70c-4590-a181-72513c24826c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"reversePD", "[", "p_PD", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"Length", "[", "p", "]"}]}], " ", "+", " ", "1"}]}], "}"}], 
      ",", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", " ", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], 
          "]"}], " ", ":>", " ", 
         RowBox[{"X", "[", 
          RowBox[{
           RowBox[{"s", " ", "-", " ", "k"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "l"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "i"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "j"}]}], "]"}]}], ",", " ", "1"}], 
       "]"}]}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->"ca25ac7e-\
9fd2-4473-a7c0-b30ffc1ac99c"],

