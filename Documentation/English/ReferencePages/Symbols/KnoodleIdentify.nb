Cell[CellGroupData[{

Cell["", "ExampleDelimiter",ExpressionUUID->"78fac9d3-4745-4577-90dd-936311b04d9c"],

Cell["\<\
9_32 is chiral and noninvertible, so its four symmetry variants (identity, \
reverse, mirror, mirror-reverse) are four genuinely different oriented knots, \
and KnoodleIdentify assigns each its own coset. Mirroring a PD code flips \
every crossing; reversal renumbers the arcs backwards:\
\>", "ExampleText",ExpressionUUID->"4af6eb47-0979-4504-b874-b3398213b68a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mirrorPD", "[", "p_PD", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"Length", "[", "p", "]"}]}], "}"}], ",", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", " ", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], 
          "]"}], " ", ":>", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"l", " ", "-", " ", "j"}], ",", " ", 
              RowBox[{"2", "*", "n"}]}], "]"}], " ", "==", " ", "1"}], ",", 
           " ", 
           RowBox[{"X", "[", 
            RowBox[{"j", ",", " ", "k", ",", " ", "l", ",", " ", "i"}], "]"}],
            ",", " ", 
           RowBox[{"X", "[", 
            RowBox[{"l", ",", " ", "i", ",", " ", "j", ",", " ", "k"}], 
            "]"}]}], "]"}]}], ",", " ", "1"}], "]"}]}], "]"}]}], ";"}], 
  " "}]], "Input",ExpressionUUID->"c83e0ce1-5749-4f48-8409-5825d7889710"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"reversePD", "[", "p_PD", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", " ", "=", " ", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{"Length", "[", "p", "]"}]}], " ", "+", " ", "1"}]}], "}"}], 
      ",", " ", 
      RowBox[{"Replace", "[", 
       RowBox[{"p", ",", " ", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"i_", ",", " ", "j_", ",", " ", "k_", ",", " ", "l_"}], 
          "]"}], " ", ":>", " ", 
         RowBox[{"X", "[", 
          RowBox[{
           RowBox[{"s", " ", "-", " ", "k"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "l"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "i"}], ",", " ", 
           RowBox[{"s", " ", "-", " ", "j"}]}], "]"}]}], ",", " ", "1"}], 
       "]"}]}], "]"}]}], ";"}], " "}]], "Input",ExpressionUUID->"e2fdd6e7-\
8330-4fd6-bc3b-c39b2f9389ca"],

